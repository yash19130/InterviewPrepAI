# Required for real Gemini generation. If unset, the app uses deterministic fallback generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_RETRIES=0
GEMINI_REQUEST_TIMEOUT_MS=3000
GEMINI_RETRY_INITIAL_DELAY_MS=250

# Firebase client config for browser auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK config for API route token verification and Firestore writes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional later runtime settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Enables reliable Reddit interview-discussion search via Reddit OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=InterviewPrepAI/0.1 by your_reddit_username

# Optional. Preferred Reddit interview-discussion search via Apify.
APIFY_API_KEY=
APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper
